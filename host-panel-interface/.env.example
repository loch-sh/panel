# Local development configuration (copy to .env).
# In Docker, use the same names without the VITE_ prefix (API_URL, APP_NAME, ...)
# as container environment variables: they are applied at container start.

# Host Panel API
VITE_API_URL=http://localhost:2538
VITE_WS_URL=ws://localhost:2538

# Branding (optional). Files placed in public/branding/ are served at /branding/.
# VITE_APP_NAME=Loch.sh Panel
# VITE_LOGO_URL=/branding/logo.png
# VITE_FAVICON_URL=/branding/favicon.png

# Home page support block (optional, hidden when empty)
# VITE_SUPPORT_PHONE=+33100000000
# VITE_SUPPORT_URL=https://support.example.com
# VITE_STATUS_URL=https://status.example.com
