    "@xterm/xterm": "^6.0.0",
    "antd": "^6.6.8",
    "axios": "^1.21.0",
    "classnames": "^2.5.1",
    "cronstrue": "^3.38.0",
    "d3": "^7.9.0",
    "date-fns": "^4.4.0",
    "dayjs": "1.11.19",
    "fuse.js": "^7.5.0",
    "i18next": "^26.7.1",
    "i18next-browser-languagedetector": "^8.3.0",
    "oidc-client-ts": "^3.4.1",
    "react": "^19.3.1",
    "react-countup": "^6.5.3",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.11",
    "react-oidc-context": "^3.3.1",
    "react-router": "^8.5.1",
    "react-toastify": "^11.2.0",
    "styled-components": "^6.6.0"
