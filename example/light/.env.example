# Copy to .env. Read by Compose for compose.yaml and app.env.

# Base domain: every public host is a subdomain of it
# (manager.<DOMAIN>, manager.api.<DOMAIN>, deploy.<DOMAIN>).
# Default: 127.0.0.1.traefik.me, a public DNS name that resolves any
# <x>.127.0.0.1.traefik.me to 127.0.0.1, to run the stack locally without a
# DNS record (self-signed certificate, see README). In production, a domain
# whose records point to the server, e.g. infra.example.com.
DOMAIN=127.0.0.1.traefik.me

# E-mail of the Let's Encrypt account (expiry notices).
ACME_EMAIL=admin@example.com

# Root of every host directory of the stack (default /data). Change it only for a
# local run (absolute path, e.g. /Users/me/panel/example/light/data, see README).
# DATA_ROOT=/data

# deploy-server: GitLab instance issuing the CI ID tokens (host name only).
GITLAB_HOST=gitlab.com
# GitLab groups allowed to deploy, comma-separated.
DEPLOY_NAMESPACES=my-group
# IPs/CIDRs of the CI runners allowed to call deploy-server, comma-separated.
DEPLOY_ALLOWED_IPS=203.0.113.0/24
