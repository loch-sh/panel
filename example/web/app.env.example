# Copy to app.env: environment of the api service. ${DOMAIN} and ${DATA_ROOT}
# come from .env. Every variable is checked at startup: a missing or invalid
# value stops the API with the list of problems (docker compose logs api).
# Reference: host-panel-api/docs/configuration.md

# ── Authentication (OIDC) ─────────────────────────────────────────────────────
# microsoft, keycloak or generic. Callback URL to register at the provider:
# https://manager.api.<DOMAIN>/openid-connect/redirect
OIDC_PROVIDER=microsoft
CLIENT_ID=
CLIENT_SECRET=
SCOPE=openid email profile
# Microsoft Entra ID
TENANT_ID=
APPLICATION_ID=
# Keycloak
# KEYCLOAK_URL=https://keycloak.example.com
# KEYCLOAK_REALM=my-realm
# Generic (Authentik, Authelia, Zitadel, Auth0, Okta, Google, GitLab…)
# OIDC_DISCOVERY_URL=https://auth.example.com/.well-known/openid-configuration

# ── Core ──────────────────────────────────────────────────────────────────────
REDIRECT_URI=https://manager.api.${DOMAIN}
FRONT_URL=https://manager.${DOMAIN}
# Session cookie on the API host only (default). Never set it to .${DOMAIN}:
# the browser would send the admin session to every site under DOMAIN.
# COOKIE_DOMAIN=
# Long random strings: openssl rand -hex 32
COOKIE_SECRET=
PASSWORD_SECRET=
# Traefik's fixed IP on loch-panel (compose.yaml): the only peer allowed to set
# X-Forwarded-For (client IP of the rate limit and the audit trail).
TRUSTED_PROXIES=10.255.252.2
# Ranges used outside the panel's networks: the fixed /29 networks of
# compose.yaml, plus the LAN/VPN ranges of the host (comma-separated).
NETWORKS_RESERVED_RANGES=10.255.0.0/16

# ── Web hosting (docs/hosting.md) ─────────────────────────────────────────────
HOSTING_ENABLED=true
# Shared with deploy-server (COMPOSE_BASE): CI stacks are listed too.
HOSTING_STACKS_DIRECTORY=${DATA_ROOT:-/data}/compose
HOSTING_SITES_DIRECTORY=${DATA_ROOT:-/data}/websites/hosted
HOSTING_TRAEFIK_NETWORK=traefik_default
# HOSTING_TRAEFIK_CERTRESOLVER=letsencrypt
# Owner of the site directories, = user of sftpgo (compose.yaml)
HOSTING_RUN_UID=1000
HOSTING_RUN_GID=1000
# HOSTING_DEFAULT_MEMORY_MB=512
# HOSTING_MAX_MEMORY_MB=2048

# ── SFTP users (docs/sftp.md) ─────────────────────────────────────────────────
SFTP_ENABLED=true
# = HOSTING_SITES_DIRECTORY: SFTPGo mounts it at the same path
SFTP_DIRECTORY=${DATA_ROOT:-/data}/websites/hosted
SFTP_API_URL=http://sftpgo:8081
# Admin API key created in the SFTPGo admin interface (see README)
SFTP_API_KEY=
SFTP_DOMAIN=ftp.${DOMAIN}
SFTP_PORT=2022
SFTP_WEB_USER_INTERFACE=https://ftp.${DOMAIN}/web/client
# SFTP_INIT_DIRS=web,logs

# ── Managed services: databases, cache, messaging, storage (docs/services.md) ─
SERVICES_ENABLED=true
SERVICES_DATA_DIRECTORY=${DATA_ROOT:-/data}/services
# Enabled engines (empty: all), e.g. postgres,mariadb,redis
# SERVICES_ENGINES=
# Ports published from the panel: loopback only by default
# SERVICES_EXPOSE_ALLOWED_CIDRS=127.0.0.1
# SERVICES_PUBLIC_HOST=db.example.com
