# Every variable is checked at startup: an invalid value, a missing required variable, an unknown
# variable with a known prefix (OIDC_, SFTP_, HOSTING_, SERVICES_, FUNCTIONS_, NETWORKS_, CRON_,
# COOKIE_, KEYCLOAK_, TRUSTED_: usually a typo) or a removed one stops the API, all problems listed at once.

# OIDC provider (microsoft, keycloak or generic)
OIDC_PROVIDER=microsoft

# OIDC — common (required whatever the provider)
CLIENT_ID=your-client-id
CLIENT_SECRET=your-client-secret
REDIRECT_URI=http://localhost:2538
SCOPE=openid email profile

# OIDC — Microsoft Entra ID (required if OIDC_PROVIDER=microsoft)
TENANT_ID=your-azure-tenant-id
APPLICATION_ID=your-application-id

# OIDC — Keycloak (required if OIDC_PROVIDER=keycloak)
# KEYCLOAK_URL=https://keycloak.example.com
# KEYCLOAK_REALM=your-realm

# OIDC — generic (required if OIDC_PROVIDER=generic)
# Compatible: Authentik, Authelia, Zitadel, Auth0, Okta, Google, GitLab…
# OIDC_DISCOVERY_URL=https://auth.example.com/.well-known/openid-configuration

# Frontend URL (CORS, CSRF checks, redirections)
FRONT_URL=http://localhost:5173

# Security
COOKIE_SECRET=a-secret-of-at-least-32-characters-here
PASSWORD_SECRET=required-but-not-used-yet
COOKIE_DOMAIN=

# Reverse proxies allowed to set X-Forwarded-For (client IP of the rate limiting and the audit
# trail), comma-separated CIDRs or addresses. The loopback is always trusted. Set it to the
# subnet of the network shared with Traefik, e.g. 172.18.0.0/16 (docker network inspect traefik).
# TRUSTED_PROXIES=

# Private networks (sites and service instances): maximum number of networks
# NETWORKS_MAX=50
# Ranges used outside Docker (LAN, VPN, static routes), comma-separated IPv4 CIDRs: no private
# network may overlap them (Docker only checks its own networks). A subnet allocated by Docker in
# one of them is given back (choose a subnet, or adjust default-address-pools of the daemon).
# NETWORKS_RESERVED_RANGES=192.168.1.0/24,10.8.0.0/16

# Runtime
APP_ENV=development
PORT=2538
DATA_DIR=./data

# SFTP — SFTPGo users (web agency mode), optional
# Enable the SFTP plugin
SFTP_ENABLED=false
# Base directory of the sites
# SFTP_DIRECTORY=/data/websites/hosted
# Internal URL of the SFTPGo admin API (required if SFTP_ENABLED=true)
# SFTP_API_URL=http://sftpgo:8080
# SFTPGo admin API key (required if SFTP_ENABLED=true)
# SFTP_API_KEY=
# SFTP host shown to the users
# SFTP_DOMAIN=sftp.example.com
# SFTP port shown to the users
# SFTP_PORT=2222
# URL of the SFTPGo web client
# SFTP_WEB_USER_INTERFACE=https://sftp.example.com/web/client
# Directories created in the home of a new user (option checked by default). Empty: none
# SFTP_INIT_DIRS=web,logs

# Services — managed databases, caches and message brokers, optional (see docs/services.md)
# Compose files go to HOSTING_STACKS_DIRECTORY (same path on the host and in the API container).
SERVICES_ENABLED=false
# Data of the instances (same path on the host and in the API container, outside HOSTING_STACKS_DIRECTORY)
# SERVICES_DATA_DIRECTORY=/data/services
# Docker network shared by the instances and the sites (created internal if missing; it is the
# "services" network of the Networks page). Private networks are created in the panel.
# SERVICES_NETWORK=loch-services
# Enabled engines, comma-separated; empty: all.
# Engines: postgres, mariadb, mysql, mongodb (databases), redis, valkey (cache), rabbitmq, nats (messaging),
# elasticmq, mosquitto (queues), s3 (storage).
# Example: PostgreSQL and MariaDB only (the others disappear from the menu, the API and the CLI):
# SERVICES_ENGINES=postgres,mariadb
# Disabling an engine deletes nothing: its instances keep running, but the panel ignores them
# (not listed, changed or removed) until it is enabled again.
# An unknown engine, or versions pinned for an engine that is not enabled, stop the API at startup.
# Versions: discovered on the registries (tags of Docker Hub / ghcr.io, image checked on mirror.gcr.io)
# with their end of support (endoflife.date). Creation offers the latest supported version of the
# 3 latest majors; dedicated instances (Redis, Valkey, NATS, Loch S3, ElasticMQ, Mosquitto) can be
# updated in one click to a new image of their version or to one of the 3 latest newer versions.
# Until a first discovery succeeds (no outbound access), a built-in catalog is used.
# Outbound HTTPS: registry-1.docker.io, auth.docker.io, ghcr.io, mirror.gcr.io, endoflife.date.
# Hours between two discoveries (0: only on demand, "Check for updates" button / loch services updates --check):
# SERVICES_UPDATE_CHECK_INTERVAL=12
# Versions always offered, even out of support or older than the 3 latest majors (comma-separated):
# SERVICES_MYSQL_PINNED_VERSIONS=5.6
# SERVICES_POSTGRES_PINNED_VERSIONS=15
# (one variable per engine: SERVICES_<ENGINE>_PINNED_VERSIONS; the former SERVICES_<ENGINE>_VERSIONS
# filters were removed and stop the API with a hint)
# Topology: databases and RabbitMQ share one instance per version (a database / a virtual host per
# resource); Redis, Valkey and NATS (light) get one container per resource, sized at creation
# (memory, options). Maximum number of these containers, per engine:
# SERVICES_MAX_DEDICATED_INSTANCES=20
# (MongoDB cannot require TLS yet: it can only be published outside the loopback with SERVICES_TLS=off)
# Maximum number of resources per shared instance
# SERVICES_MAX_RESOURCES_PER_INSTANCE=50
# Rename the data of a removed instance (…-retired-<date>) instead of deleting it
# SERVICES_ARCHIVE_ON_RETIRE=false

# Published ports are chosen in the panel (instance page, "Exposure"), on ports 1024–32767, only
# on the host addresses listed here: comma-separated CIDRs or addresses (default 127.0.0.1).
# These are the addresses the port listens on, NOT the clients allowed: Docker cannot filter the
# clients of a published port (filter them with the DOCKER-USER iptables chain).
# 0.0.0.0 (every interface) must be listed alone, never through a range.
# Out-of-support versions, engines without authentication and engines that cannot require TLS
# stay on the loopback.
# SERVICES_EXPOSE_ALLOWED_CIDRS=127.0.0.1,203.0.113.10
# Required for any non-loopback address above. WARNING: Docker bypasses ufw/firewalld.
# SERVICES_ALLOW_PUBLIC_BIND=false
# auto: TLS required (from every client of the instance) once it is published outside the loopback;
# off: TLS disabled everywhere, deliberately (clear-text passwords on the published ports).
# SERVICES_TLS=auto
# Allow, per exposure in the panel, TLS offered but NOT required (old clients without TLS;
# PostgreSQL, MySQL 8.4, MariaDB only). Plain clients send passwords in clear on that port.
# SERVICES_ALLOW_TLS_OPTIONAL=false
# Host name shown to clients for external access, covered by the self-signed certificates
# SERVICES_PUBLIC_HOST=db.example.com
# Certificate (and key) to use instead of the self-signed ones (e.g. ACME)
# SERVICES_TLS_CERT_FILE=
# SERVICES_TLS_KEY_FILE=
# Loch S3 (object storage): leave empty for one instance per resource (the
# only mode available). Setting a key selects the shared mode, not available
# yet: the s3 engine is then disabled.
# SERVICES_S3_ADMIN_API_KEY=

# Functions — serverless AWS Lambda handlers (Node.js, Python), optional, work in progress
# (see docs/functions.md). Compose files go to HOSTING_STACKS_DIRECTORY (fn-<name>).
FUNCTIONS_ENABLED=false
# Code (deployments), loch Lambda runtime binaries, secrets and private references: same path on
# the host and in the API container, letters, digits and _ . / - only, outside
# HOSTING_STACKS_DIRECTORY, HOSTING_SITES_DIRECTORY, SFTP_DIRECTORY, SERVICES_DATA_DIRECTORY,
# and API_LOG_DIR; a subdirectory of DATA_DIR is fine (checked at startup, symlinks resolved).
# FUNCTIONS_DATA_DIRECTORY=/data/functions
# Maximum number of functions
# FUNCTIONS_MAX=50
# Maximum memory of one function (MB, or with a unit: 3G)
# FUNCTIONS_MAX_MEMORY=3008
# Maximum size of an uploaded zip (MB, 1 to 250; extracted code is capped at 250 MB)
# FUNCTIONS_MAX_CODE_SIZE=50
# Deployments kept per function for an instant rollback (the active one included)
# FUNCTIONS_DEPLOYMENTS_KEPT=3
# Default size of the /tmp tmpfs of a function (MB, like Lambda's 512 MB); it counts against the
# memory limit of the function
# FUNCTIONS_TMP_SIZE=512
# Global budget: sum of the memory limits of every function (MB, or 64G), and of their CPU limits.
# 0 (default) = the memory of the Docker host, and 4 × its CPUs.
# FUNCTIONS_MAX_TOTAL_MEMORY=0
# FUNCTIONS_MAX_TOTAL_CPUS=0
# loch Lambda runtime binary: the newest release of github.com/loch-sh/lambda-runtime (v1.0.1 or
# later) is found at startup and every hour, its binary downloaded and checked against the sha256
# of its SHA256SUMS, then that sha256 recorded (HTTPS, GitHub hosts only). false = no download.
# FUNCTIONS_RUNTIME_DOWNLOAD=true
# Offline: a directory holding one directory per release (vX.Y.Z/, with its SHA256SUMS and
# loch-lambda-runtime-linux-<arch> files as published), read instead of downloading (takes
# precedence over the download). Everything must be owned by the API user or root and writable by
# nobody else.
# FUNCTIONS_RUNTIME_SOURCE_DIR=
